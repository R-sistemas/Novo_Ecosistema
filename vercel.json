{
  "functions": {
    "api/cadastrar-operador.mjs": { "maxDuration": 45 },
    "api/checkout-pix-mercado-pago-teste.mjs": { "maxDuration": 45 }
  },
  "rewrites": [
    { "source": "/api/painel-visao", "destination": "/api/cadastrar-operador?painel_visao=1" },
    { "source": "/api/painel-pedidos", "destination": "/api/cadastrar-operador?painel_pedidos=1" },
    { "source": "/api/painel-preferencias", "destination": "/api/cadastrar-operador?painel_preferencias=1" },
    { "source": "/api/painel-equipe", "destination": "/api/cadastrar-operador?painel_equipe=1" },
    { "source": "/api/painel-catalogo", "destination": "/api/cadastrar-operador?painel_catalogo=1" },
    { "source": "/api/painel-sessao", "destination": "/api/cadastrar-operador?painel_sessao=1" },
    { "source": "/api/cotar-frete", "destination": "/api/checkout-pix-mercado-pago-teste?cotacao_frete=1" },
    { "source": "/api/monitor-gestor", "destination": "/api/cadastrar-operador?monitor=1" },
    { "source": "/api/despachar-remo", "destination": "/api/cadastrar-operador?despacho_remo=1" },
    { "source": "/api/status-despacho-remo", "destination": "/api/cadastrar-operador?status_remo=1" }
  ],
  "headers": [
    {
      "source": "/monitor.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" }
      ]
    }
  ]
}
